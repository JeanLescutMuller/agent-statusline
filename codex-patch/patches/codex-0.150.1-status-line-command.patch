+    fn request_status_line_command_if_due(&mut self, now: Instant) {
+        use std::sync::atomic::Ordering;
+
+        if !self
+            .status_line_items_with_invalids()
+            .0
+            .contains(&StatusLineItem::Custom)
+        {
+            return;
+        }
+
+        let snapshot = self.status_line_command_json_snapshot();
+        let changed = self.status_line_command.last_snapshot.as_deref() != Some(&snapshot);
+        let elapsed = self
+            .status_line_command
+            .last_requested_at
+            .is_none_or(|last| {
+                now.saturating_duration_since(last) >= STATUS_LINE_COMMAND_REFRESH_INTERVAL
+            });
+        if (!changed && !elapsed)
+            || self
+                .status_line_command
+                .pending
+                .swap(true, Ordering::AcqRel)
+        {
+            return;
+        }
+
+        self.status_line_command.last_snapshot = Some(snapshot.clone());
+        self.status_line_command.last_requested_at = Some(now);
+        self.frame_requester
+            .schedule_frame_in(STATUS_LINE_COMMAND_REFRESH_INTERVAL);
+
+        let output = self.status_line_command.output.clone();
+        let pending = self.status_line_command.pending.clone();
+        let frame_requester = self.frame_requester.clone();
+        let script = std::env::var_os("CODEX_STATUS_LINE_COMMAND")
+            .map(std::path::PathBuf::from)
+            .or_else(|| {
+                std::env::var_os("HOME")
+                    .map(|home| std::path::PathBuf::from(home).join(".codex/statusline-command.sh"))
+            });
+
+        tokio::spawn(async move {
+            if let Some(script) = script
+                && let Ok(Some(line)) = Self::run_status_line_command(&script, &snapshot).await
+                && let Ok(mut current) = output.lock()
+            {
+                *current = Some(line);
+            }
+            pending.store(false, Ordering::Release);
+            frame_requester.schedule_frame();
+        });
+    }
